# MySQL configuration (Recommended)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/notes_db

# SQLite configuration fallback (Uncomment to use local file DB)
# DATABASE_URL=sqlite:///./notes.db

# PostgreSQL configuration example (Uncomment if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/notes_db
